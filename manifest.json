{
  "name": "喵~网址导航",
  "description": "网址导航",
  "version": "1.2",
  "homepage_url": "https://maolihui.com",
  "manifest_version": 3,
  "icons": {
    "128": "img/128.png",
    "48": "img/48.png",
    "16": "img/16.png"
