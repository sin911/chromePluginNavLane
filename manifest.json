  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "chrome_url_overrides":{
    "newtab":"home.html"
  },
  "permissions": ["tabs","storage"],
  "host_permissions": ["https://api.github.com/*"]
}
